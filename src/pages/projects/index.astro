---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import site from "../../data/site.json";
import { withBase } from "../../utils/paths";

const [allProjects, posts] = await Promise.all([
  getCollection("projects"),
  getCollection("blog", ({ data }) => !data.draft),
]);
const projects = allProjects.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const current = projects.filter((p) => p.data.status === "current");
const past = projects.filter((p) => p.data.status === "past");

function relatedPostsFor(projectId: string) {
  return posts
    .filter((post) => post.data.projects.includes(projectId))
    .map((post) => ({ title: post.data.title, href: withBase(`/blog/${post.id}`) }));
}
---

<BaseLayout title={`Projects — ${site.name}`} description="Current and past projects by Vaibhav Parasa.">
  <section class="section hero-section">
    <div class="container">
      <p class="section-label">Projects</p>
      <h1 class="section-title">Current &amp; past projects</h1>
      <p class="lede">A mix of production systems and self-directed builds — agentic AI, ML pipelines, and backend infrastructure.</p>
    </div>
  </section>

  {current.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="group-title">Current</h2>
        <div class="projects-grid">
          {current.map((project) => (
            <ProjectCard
              id={project.id}
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              githubUrl={project.data.githubUrl}
              liveUrl={project.data.liveUrl}
              status={project.data.status}
              relatedPosts={relatedPostsFor(project.id)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {past.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="group-title">Past</h2>
        <div class="projects-grid">
          {past.map((project) => (
            <ProjectCard
              id={project.id}
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              githubUrl={project.data.githubUrl}
              liveUrl={project.data.liveUrl}
              status={project.data.status}
              relatedPosts={relatedPostsFor(project.id)}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero-section {
    padding-bottom: 1rem;
  }

  .lede {
    max-width: 55ch;
  }

  .group-title {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 700px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
