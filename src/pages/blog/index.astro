---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import site from "../../data/site.json";
import { withBase } from "../../utils/paths";
import { formatDate } from "../../utils/formatDate";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.date.getTime() - a.data.date.getTime();
});
---

<BaseLayout title={`Blog — ${site.name}`} description="Notes on ML, agentic AI, and building production data systems.">
  <section class="section">
    <div class="container">
      <p class="section-label">Blog</p>
      <h1 class="section-title">Writing</h1>
      <p class="lede">Notes on the ML and agentic AI systems I'm building, and what I'm learning along the way.</p>

      {posts.length === 0 ? (
        <p class="empty">No posts yet — check back soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-item">
              <a href={withBase(`/blog/${post.id}`)} class="post-link">
                <div class="post-head">
                  <h2>{post.data.title}</h2>
                  <span class="post-date">{formatDate(post.data.date)}</span>
                </div>
                <p class="post-desc">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="post-tags">
                    {post.data.tags.map((tag) => (
                      <span class="pill">{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    max-width: 55ch;
    margin-bottom: 2.5rem;
  }

  .empty {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-link {
    display: block;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .post-link:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .post-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-head h2 {
    font-size: 1.1rem;
    margin: 0;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .post-desc {
    margin: 0.5rem 0 0.9rem;
    font-size: 0.92rem;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
</style>
