---
interface Props {
  title: string;
  description: string;
  tags: string[];
  status: "current" | "past";
  href: string;
}

const { title, description, tags, status, href } = Astro.props;
---

<a href={href} class="project-card card">
  <div class="project-head">
    <h3>{title}</h3>
    <span class={`status status-${status}`}>{status === "current" ? "Active" : "Past"}</span>
  </div>
  <p class="project-desc">{description}</p>
  <div class="project-tags">
    {tags.map((tag) => (
      <span class="pill">{tag}</span>
    ))}
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .project-head h3 {
    font-size: 1.05rem;
    margin: 0;
  }

  .status {
    font-family: var(--font-head);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    padding: 0.25rem 0.5rem;
    border: 2px solid var(--border);
    transform: rotate(-2deg);
  }

  .status-current {
    color: var(--accent);
    border-color: var(--accent-dim);
  }

  .status-past {
    color: var(--text-dim);
  }

  .project-desc {
    flex: 1;
    font-size: 0.92rem;
    margin: 0 0 1.1rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
