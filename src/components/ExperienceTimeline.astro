---
import { getCollection, render } from "astro:content";
import { withBase } from "../utils/paths";

const [raw, posts] = await Promise.all([
  getCollection("experience"),
  getCollection("blog", ({ data }) => !data.draft),
]);
raw.sort((a, b) => a.data.order - b.data.order);
const entries = await Promise.all(
  raw.map(async (entry) => {
    const { Content } = await render(entry);
    const relatedPosts = posts
      .filter((post) => post.data.experiences.includes(entry.id))
      .map((post) => ({ title: post.data.title, href: withBase(`/blog/${post.id}`) }));
    return { id: entry.id, data: entry.data, Content, relatedPosts };
  })
);
---

<section id="experience" class="section">
  <div class="container">
    <p class="section-label">Experience</p>
    <h2 class="section-title">Where I've worked</h2>
    <ol class="timeline">
      {entries.map((entry) => (
        <li class="timeline-item" id={entry.id}>
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-content">
            <div class="timeline-head">
              <h3>{entry.data.role}</h3>
              <span class="timeline-dates">{entry.data.startDate} – {entry.data.endDate}</span>
            </div>
            <p class="timeline-company">
              {entry.data.company}{entry.data.location ? ` · ${entry.data.location}` : ""}
            </p>
            <div class="timeline-body">
              <entry.Content />
            </div>
            {entry.relatedPosts.length > 0 && (
              <div class="timeline-related">
                <span class="related-label">From the blog</span>
                <ul class="related-list">
                  {entry.relatedPosts.map((post) => (
                    <li><a href={post.href}>{post.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 1.25rem;
    padding-bottom: 2.5rem;
    position: relative;
    scroll-margin-top: 90px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: 9px;
    top: 22px;
    bottom: -2px;
    width: 1px;
    background: var(--border);
  }

  .timeline-item:last-child::before {
    display: none;
  }

  .timeline-marker {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 2px solid var(--accent-dim);
    margin-top: 2px;
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .timeline-head h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .timeline-dates {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .timeline-company {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.9rem;
    margin: 0.25rem 0 0.75rem;
  }

  .timeline-body :global(ul) {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
  }

  .timeline-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .timeline-related {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .related-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }

  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .related-list a {
    font-size: 0.88rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .related-list a:hover {
    color: var(--accent);
  }
</style>
