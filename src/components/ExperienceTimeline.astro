---
import { getCollection } from "astro:content";
import { withBase } from "../utils/paths";

const entries = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" class="section">
  <div class="container">
    <p class="section-label">Experience</p>
    <h2 class="section-title">Where I've worked</h2>
    <ol class="timeline">
      {entries.map((entry) => (
        <li class="timeline-item">
          <div class={`timeline-marker ${entry.data.endDate.toLowerCase() === "present" ? "is-active" : ""}`} aria-hidden="true"></div>
          <a href={withBase(`/experience/${entry.id}`)} class="timeline-content">
            <div class="timeline-head">
              <h3>{entry.data.role}</h3>
              <span class="timeline-dates">{entry.data.startDate} – {entry.data.endDate}</span>
            </div>
            <p class="timeline-company">
              {entry.data.company}{entry.data.location ? ` · ${entry.data.location}` : ""}
            </p>
            <p class="timeline-summary">{entry.data.summary}</p>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 1.25rem;
    padding-bottom: 2.5rem;
    position: relative;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: 9px;
    top: 22px;
    bottom: -2px;
    width: 1px;
    background: var(--border);
  }

  .timeline-item:last-child::before {
    display: none;
  }

  .timeline-marker {
    width: 20px;
    height: 20px;
    background: var(--bg-elevated);
    border: 2px solid var(--accent-dim);
    margin-top: 2px;
    position: relative;
  }

  .timeline-marker.is-active {
    border-color: var(--accent);
  }

  .timeline-marker.is-active::after {
    content: "";
    position: absolute;
    inset: 3px;
    background: var(--accent);
    animation: pulse 1.1s steps(2) infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.15;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-marker.is-active::after {
      animation: none;
    }
  }

  .timeline-content {
    display: block;
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .timeline-head h3 {
    margin: 0;
    font-size: 1.05rem;
    transition: color 0.2s ease;
  }

  .timeline-content:hover .timeline-head h3 {
    color: var(--accent);
  }

  .timeline-dates {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .timeline-company {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.9rem;
    margin: 0.25rem 0 0.5rem;
  }

  .timeline-summary {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 0;
  }
</style>
