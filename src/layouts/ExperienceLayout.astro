---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../utils/paths";

interface Props {
  role: string;
  company: string;
  location?: string;
  startDate: string;
  endDate: string;
  summary: string;
  related?: { title: string; href: string }[];
}

const { role, company, location, startDate, endDate, summary, related } = Astro.props;
---

<BaseLayout title={`${role} — ${company}`} description={summary}>
  <article class="section post">
    <div class="container container-narrow">
      <a href={withBase("/#experience")} class="back-link">← Back to experience</a>

      <h1 class="role-title">{role}</h1>
      <p class="role-meta">
        {company}{location ? ` · ${location}` : ""} · {startDate} – {endDate}
      </p>

      <p class="role-summary">{summary}</p>

      <div class="project-block">
        <h2>Summary</h2>
        <div class="project-content">
          <slot />
        </div>
      </div>

      {related && related.length > 0 && (
        <div class="project-block">
          <h2>From the blog</h2>
          <ul class="related-list">
            {related.map((post) => (
              <li><a href={post.href}>{post.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .container-narrow {
    max-width: 720px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .role-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 0 0 0.5rem;
  }

  .role-meta {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }

  .role-summary {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0 0 2.5rem;
  }

  .project-block {
    margin-bottom: 2.5rem;
  }

  .project-block h2 {
    font-size: 1.15rem;
    margin: 0 0 1rem;
  }

  .project-content {
    color: var(--text);
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    color: var(--text-muted);
    margin: 0;
    padding-left: 1.1rem;
  }

  .project-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .project-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-dim);
  }

  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .related-list a {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .related-list a:hover {
    color: var(--accent);
  }
</style>
