---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  description: string;
  status: "current" | "past";
  tags: string[];
  githubUrl?: string;
  liveUrl?: string;
  hasSummary: boolean;
  related?: { title: string; href: string }[];
}

const { title, description, status, tags, githubUrl, liveUrl, hasSummary, related } = Astro.props;
---

<BaseLayout title={`${title} — Projects`} description={description}>
  <article class="section post">
    <div class="container container-narrow">
      <a href={withBase("/projects")} class="back-link">← Back to projects</a>

      <div class="project-head">
        <h1 class="project-title">{title}</h1>
        <span class={`status status-${status}`}>{status === "current" ? "Active" : "Past"}</span>
      </div>

      {(githubUrl || liveUrl) && (
        <div class="project-links">
          {githubUrl && (
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn">Source →</a>
          )}
          {liveUrl && (
            <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="btn">Live →</a>
          )}
        </div>
      )}

      <p class="project-desc">{description}</p>

      {hasSummary && (
        <div class="project-block">
          <h2>Summary</h2>
          <div class="project-content">
            <slot />
          </div>
        </div>
      )}

      {tags.length > 0 && (
        <div class="project-block">
          <h2>Tools Used</h2>
          <div class="tag-list">
            {tags.map((tag) => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>
      )}

      {related && related.length > 0 && (
        <div class="project-block">
          <h2>From the blog</h2>
          <ul class="related-list">
            {related.map((post) => (
              <li><a href={post.href}>{post.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .container-narrow {
    max-width: 720px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .project-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .project-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 0;
  }

  .status {
    font-family: var(--font-head);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    padding: 0.35rem 0.65rem;
    border: 2px solid var(--border);
    transform: rotate(-2deg);
    margin-top: 0.3rem;
  }

  .status-current {
    color: var(--accent);
    border-color: var(--accent-dim);
  }

  .status-past {
    color: var(--text-dim);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .project-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0 0 2.5rem;
  }

  .project-block {
    margin-bottom: 2.5rem;
  }

  .project-block h2 {
    font-size: 1.15rem;
    margin: 0 0 1rem;
  }

  .project-content {
    color: var(--text);
  }

  .project-content :global(p) {
    color: var(--text-muted);
  }

  .project-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-dim);
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    color: var(--text-muted);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .related-list a {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .related-list a:hover {
    color: var(--accent);
  }
</style>
